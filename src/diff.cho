edition 7;
module diff;
import std.result;
import std.buffer;

fn diff_count_lines[&r](a: &r [byte]) -> [] int {
    var lines = 0;
    var i = 0;
    while i < len(a) {
        if int_of(a[i]) == 10 {
            lines = lines + 1;
        }
        i = i + 1;
    }
    if len(a) > 0 && int_of(a[len(a) - 1]) != 10 {
        lines = lines + 1;
    }
    return lines;
}

fn diff_line_end[&r](a: &r [byte], start: int) -> [] int {
    var answer = len(a);
    var pos = start;
    if pos < 0 {
        pos = 0;
    }
    var found = 0;
    while pos < len(a) && found == 0 {
        if int_of(a[pos]) == 10 {
            answer = pos + 1;
            found = 1;
        }
        pos = pos + 1;
    }
    return answer;
}

fn diff_line_eq[&ra, &rb](a: &ra [byte], s: int, e: int, b: &rb [byte], t: int, u: int) -> [] bool {
    if s < 0 || e < s || e > len(a) {
        return false;
    }
    if t < 0 || u < t || u > len(b) {
        return false;
    }
    if e - s != u - t {
        return false;
    }
    var i = 0;
    var same = 1;
    while i < e - s && same == 1 {
        if int_of(a[s + i]) != int_of(b[t + i]) {
            same = 0;
        }
        i = i + 1;
    }
    return same == 1;
}

pub fn edit_count[&h, &ra, &rb](heap: &!h Heap, a: &ra [byte], b: &rb [byte]) -> [heap] int {
    let n = diff_count_lines(a);
    let m = diff_count_lines(b);
    let width = m + 1;
    let table = box_slice(heap, 2 * width, 0);
    var lcs = 0;
    borrow mut table as &!t in {
        let cells = contents(t);
        var prev = 0;
        var cur = width;
        var sa = 0;
        var i = 0;
        while i < n {
            let ea = diff_line_end(a, sa);
            var sb = 0;
            var j = 0;
            cells[cur] = 0;
            while j < m {
                let eb = diff_line_end(b, sb);
                if diff_line_eq(a, sa, ea, b, sb, eb) {
                    cells[cur + j + 1] = cells[prev + j] + 1;
                } else {
                    let up = cells[prev + j + 1];
                    let left = cells[cur + j];
                    if up >= left {
                        cells[cur + j + 1] = up;
                    } else {
                        cells[cur + j + 1] = left;
                    }
                }
                sb = eb;
                j = j + 1;
            }
            sa = ea;
            let tmp = prev;
            prev = cur;
            cur = tmp;
            i = i + 1;
        }
        lcs = cells[prev + m];
    }
    unbox_slice(heap, table);
    return n + m - 2 * lcs;
}

fn diff_range[&h](heap: &!h Heap, start: int, count: int) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, 16);
    out = buffer.push_nat(heap, out, start);
    if count != 1 {
        out = buffer.push(heap, out, byte_of(44));
        out = buffer.push_nat(heap, out, count);
    }
    return out;
}

fn diff_line_start[&r](a: &r [byte], k: int) -> [] int {
    var pos = 0;
    var c = 0;
    while c < k {
        pos = diff_line_end(a, pos);
        c = c + 1;
    }
    return pos;
}

fn diff_line_eq_at[&ra, &rb](a: &ra [byte], i: int, b: &rb [byte], j: int) -> [] bool {
    let s = diff_line_start(a, i);
    let e = diff_line_end(a, s);
    let t = diff_line_start(b, j);
    let u = diff_line_end(b, t);
    return diff_line_eq(a, s, e, b, t, u);
}

fn diff_table[&h, &ra, &rb](heap: &!h Heap, a: &ra [byte], b: &rb [byte]) -> [heap] Box[[int]] {
    let n = diff_count_lines(a);
    let m = diff_count_lines(b);
    let width = m + 1;
    let table = box_slice(heap, (n + 1) * width, 0);
    borrow mut table as &!t in {
        let cells = contents(t);
        var sa = 0;
        var i = 1;
        while i <= n {
            let ea = diff_line_end(a, sa);
            var sb = 0;
            var j = 1;
            while j <= m {
                let eb = diff_line_end(b, sb);
                if diff_line_eq(a, sa, ea, b, sb, eb) {
                    cells[i * width + j] = cells[(i - 1) * width + j - 1] + 1;
                } else {
                    let up = cells[(i - 1) * width + j];
                    let left = cells[i * width + j - 1];
                    if up >= left {
                        cells[i * width + j] = up;
                    } else {
                        cells[i * width + j] = left;
                    }
                }
                sb = eb;
                j = j + 1;
            }
            sa = ea;
            i = i + 1;
        }
    }
    return table;
}

fn diff_next_change[&r](script: &r [int], from: int, total: int) -> [] int {
    var k = from;
    var found = total;
    while k < total && found == total {
        if script[k] != 0 {
            found = k;
        }
        k = k + 1;
    }
    return found;
}

fn diff_hunk_last[&r](script: &r [int], first: int, total: int, context: int) -> [] int {
    var last = first;
    var go = 1;
    while go == 1 {
        let nxt = diff_next_change(script, last + 1, total);
        if nxt < total && nxt - last - 1 <= 2 * context {
            last = nxt;
        } else {
            go = 0;
        }
    }
    return last;
}

fn diff_put_range[&h](heap: &!h Heap, out: buffer.Buffer, start: int, count: int) -> [heap] buffer.Buffer {
    let rng = diff_range(heap, start, count);
    var o = out;
    borrow rng as &x in {
        o = buffer.append(heap, o, buffer.bytes(x));
    }
    buffer.drop(heap, rng);
    return o;
}

fn diff_put_line[&h, &r](heap: &!h Heap, out: buffer.Buffer, mark: int, text: &r [byte], start: int) -> [heap] buffer.Buffer {
    var o = buffer.push(heap, out, byte_of(mark));
    let finish = diff_line_end(text, start);
    o = buffer.append(heap, o, text[start..finish]);
    if int_of(text[finish - 1]) != 10 {
        o = buffer.push(heap, o, byte_of(10));
        o = buffer.append(heap, o, "\\ No newline at end of file\n");
    }
    return o;
}

pub fn unified[&h, &rn, &rm, &ra, &rb](heap: &!h Heap, a_name: &rn [byte], b_name: &rm [byte], a: &ra [byte], b: &rb [byte], context: int) -> [heap] buffer.Buffer {
    if diff_line_eq(a, 0, len(a), b, 0, len(b)) {
        return buffer.empty(heap, 16);
    }
    var c = context;
    if c < 0 {
        c = 0;
    }
    let n = diff_count_lines(a);
    let m = diff_count_lines(b);
    let total = n + m;
    var out = buffer.empty(heap, 256);
    out = buffer.append(heap, out, "--- ");
    out = buffer.append(heap, out, a_name);
    out = buffer.push(heap, out, byte_of(10));
    out = buffer.append(heap, out, "+++ ");
    out = buffer.append(heap, out, b_name);
    out = buffer.push(heap, out, byte_of(10));
    let table = diff_table(heap, a, b);
    let ops = box_slice(heap, total, 0);
    var p = total;
    borrow table as &q in {
        let cells = contents(q);
        borrow mut ops as &!o in {
            let script = contents(o);
            var i = n;
            var j = m;
            while i > 0 || j > 0 {
                p = p - 1;
                if i > 0 && j > 0 && diff_line_eq_at(a, i - 1, b, j - 1) {
                    script[p] = 0;
                    i = i - 1;
                    j = j - 1;
                } else if j > 0 && i == 0 {
                    script[p] = 2;
                    j = j - 1;
                } else if j > 0 && cells[i * (m + 1) + j - 1] >= cells[(i - 1) * (m + 1) + j] {
                    script[p] = 2;
                    j = j - 1;
                } else {
                    script[p] = 1;
                    i = i - 1;
                }
            }
        }
    }
    unbox_slice(heap, table);
    let steps = total - p;
    borrow ops as &q in {
        let whole = contents(q);
        let script = whole[p..total];
        var cs = 0;
        var pa = 0;
        var pb = 0;
        var ia = 0;
        var ib = 0;
        var go = 1;
        while go == 1 {
            let first = diff_next_change(script, cs, steps);
            if first >= steps {
                go = 0;
            } else {
                let last = diff_hunk_last(script, first, steps, c);
                var hs = first - c;
                if hs < 0 {
                    hs = 0;
                }
                var he = last + c + 1;
                if he > steps {
                    he = steps;
                }
                while cs < hs {
                    if script[cs] == 0 {
                        pa = diff_line_end(a, pa);
                        pb = diff_line_end(b, pb);
                        ia = ia + 1;
                        ib = ib + 1;
                    } else if script[cs] == 1 {
                        pa = diff_line_end(a, pa);
                        ia = ia + 1;
                    } else {
                        pb = diff_line_end(b, pb);
                        ib = ib + 1;
                    }
                    cs = cs + 1;
                }
                var ca = 0;
                var cb = 0;
                var s = hs;
                while s < he {
                    if script[s] != 2 {
                        ca = ca + 1;
                    }
                    if script[s] != 1 {
                        cb = cb + 1;
                    }
                    s = s + 1;
                }
                var start_a = ia;
                if ca > 0 {
                    start_a = ia + 1;
                }
                var start_b = ib;
                if cb > 0 {
                    start_b = ib + 1;
                }
                out = buffer.append(heap, out, "@@ -");
                out = diff_put_range(heap, out, start_a, ca);
                out = buffer.append(heap, out, " +");
                out = diff_put_range(heap, out, start_b, cb);
                out = buffer.append(heap, out, " @@\n");
                while cs < he {
                    if script[cs] == 0 {
                        out = diff_put_line(heap, out, 32, a, pa);
                        pa = diff_line_end(a, pa);
                        pb = diff_line_end(b, pb);
                        ia = ia + 1;
                        ib = ib + 1;
                    } else if script[cs] == 1 {
                        out = diff_put_line(heap, out, 45, a, pa);
                        pa = diff_line_end(a, pa);
                        ia = ia + 1;
                    } else {
                        out = diff_put_line(heap, out, 43, b, pb);
                        pb = diff_line_end(b, pb);
                        ib = ib + 1;
                    }
                    cs = cs + 1;
                }
            }
        }
    }
    unbox_slice(heap, ops);
    return out;
}

fn apply_copy[&h, &ra](heap: &!h Heap, a: &ra [byte]) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, 16);
    out = buffer.append(heap, out, a);
    return out;
}

fn apply_prefix[&rp, &rs](p: &rp [byte], pos: int, s: &rs [byte]) -> [] bool {
    if pos < 0 || pos + len(s) > len(p) {
        return false;
    }
    var i = 0;
    var same = 1;
    while i < len(s) && same == 1 {
        if int_of(p[pos + i]) != int_of(s[i]) {
            same = 0;
        }
        i = i + 1;
    }
    return same == 1;
}

fn apply_line_end[&rp](p: &rp [byte], pos: int) -> [] int {
    if pos < 0 || pos >= len(p) {
        return 0 - 1;
    }
    var e = pos;
    var found = 0 - 1;
    while e < len(p) && found < 0 {
        if int_of(p[e]) == 10 {
            found = e + 1;
        }
        e = e + 1;
    }
    return found;
}

fn apply_num_end[&rp](p: &rp [byte], pos: int) -> [] int {
    var e = pos;
    while e < len(p) && int_of(p[e]) >= 48 && int_of(p[e]) <= 57 {
        e = e + 1;
    }
    return e;
}

fn apply_num_val[&rp](p: &rp [byte], s: int, e: int) -> [] int {
    var v = 0;
    var i = s;
    while i < e {
        v = v * 10 + int_of(p[i]) - 48;
        i = i + 1;
    }
    return v;
}

fn apply_range_start[&rp](p: &rp [byte], pos: int) -> [] int {
    return apply_num_val(p, pos, apply_num_end(p, pos));
}

fn apply_range_end[&rp](p: &rp [byte], pos: int) -> [] int {
    let d = apply_num_end(p, pos);
    if d < len(p) && int_of(p[d]) == 44 {
        return apply_num_end(p, d + 1);
    }
    return d;
}

fn apply_range_count[&rp](p: &rp [byte], pos: int) -> [] int {
    let d = apply_num_end(p, pos);
    if d < len(p) && int_of(p[d]) == 44 {
        let e = apply_num_end(p, d + 1);
        return apply_num_val(p, d + 1, e);
    }
    return 1;
}

fn apply_range_ok[&rp](p: &rp [byte], pos: int) -> [] bool {
    let d = apply_num_end(p, pos);
    if d == pos || d - pos > 9 {
        return false;
    }
    if d < len(p) && int_of(p[d]) == 44 {
        let e = apply_num_end(p, d + 1);
        return e > d + 1 && e - (d + 1) <= 9;
    }
    return true;
}

fn apply_header_ok[&rp](p: &rp [byte], pos: int) -> [] bool {
    if !apply_prefix(p, pos, "@@ -") {
        return false;
    }
    if !apply_range_ok(p, pos + 4) {
        return false;
    }
    let mid = apply_range_end(p, pos + 4);
    if !apply_prefix(p, mid, " +") {
        return false;
    }
    if !apply_range_ok(p, mid + 2) {
        return false;
    }
    let tail = apply_range_end(p, mid + 2);
    return apply_prefix(p, tail, " @@\n");
}

pub fn apply[&h, &rp, &ra](heap: &!h Heap, patch: &rp [byte], a: &ra [byte]) -> [heap] result.Result[buffer.Buffer, int] {
    if len(patch) == 0 {
        return result.Result::Ok(apply_copy(heap, a));
    }
    var fail = 0;
    var q = apply_line_end(patch, 0);
    if q < 0 || !apply_prefix(patch, 0, "--- ") {
        fail = 1;
    } else {
        let e2 = apply_line_end(patch, q);
        if e2 < 0 || !apply_prefix(patch, q, "+++ ") {
            fail = 1;
        } else {
            q = e2;
        }
    }
    var go = 1;
    if fail != 0 {
        go = 0;
    }
    let n = diff_count_lines(a);
    var li = 0;
    var ai = 0;
    var prev_end = 0;
    var out = buffer.empty(heap, 256);
    while go == 1 && q < len(patch) {
        if !apply_header_ok(patch, q) {
            fail = 1;
            go = 0;
        } else {
            let ostart = apply_range_start(patch, q + 4);
            let ocount = apply_range_count(patch, q + 4);
            let mid = apply_range_end(patch, q + 4);
            let ncount = apply_range_count(patch, mid + 2);
            let tail = apply_range_end(patch, mid + 2);
            var ls = ostart - 1;
            if ocount == 0 {
                ls = ostart;
            }
            if ls >= 0 && ls < prev_end {
                fail = 1;
                go = 0;
            } else if ls < 0 || ls > n {
                fail = 2;
                go = 0;
            } else {
                while li < ls {
                    let ce = diff_line_end(a, ai);
                    out = buffer.append(heap, out, a[ai..ce]);
                    ai = ce;
                    li = li + 1;
                }
                var oleft = ocount;
                var nleft = ncount;
                var bq = tail + 4;
                while go == 1 && (oleft > 0 || nleft > 0) {
                    if bq >= len(patch) {
                        fail = 1;
                        go = 0;
                    } else {
                        let le = apply_line_end(patch, bq);
                        let mark = int_of(patch[bq]);
                        if le < 0 || mark != 32 && mark != 45 && mark != 43 {
                            fail = 1;
                            go = 0;
                        } else {
                            var cend = le;
                            var nxt = le;
                            if apply_prefix(patch, le, "\\ No newline at end of file\n") {
                                cend = le - 1;
                                nxt = apply_line_end(patch, le);
                            }
                            if mark == 43 {
                                if nleft == 0 {
                                    fail = 1;
                                    go = 0;
                                } else {
                                    out = buffer.append(heap, out, patch[bq + 1..cend]);
                                    nleft = nleft - 1;
                                }
                            } else if oleft == 0 || mark == 32 && nleft == 0 {
                                fail = 1;
                                go = 0;
                            } else if li >= n {
                                fail = 2;
                                go = 0;
                            } else {
                                let ce = diff_line_end(a, ai);
                                if !diff_line_eq(a, ai, ce, patch, bq + 1, cend) {
                                    fail = 2;
                                    go = 0;
                                } else {
                                    if mark == 32 {
                                        out = buffer.append(heap, out, a[ai..ce]);
                                        nleft = nleft - 1;
                                    }
                                    oleft = oleft - 1;
                                    ai = ce;
                                    li = li + 1;
                                }
                            }
                            bq = nxt;
                        }
                    }
                }
                if go == 1 {
                    q = bq;
                    prev_end = li;
                }
            }
        }
    }
    if fail == 0 {
        while li < n {
            let ce = diff_line_end(a, ai);
            out = buffer.append(heap, out, a[ai..ce]);
            ai = ce;
            li = li + 1;
        }
        return result.Result::Ok(out);
    }
    buffer.drop(heap, out);
    return result.Result::Err(fail);
}
